<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\..\00_Shared\ProductionLine.Shared\ProductionLine.Shared.csproj" />
    <ProjectReference Include="..\..\04_Vision\ProductionLine.Vision\ProductionLine.Vision.csproj" />
    <Compile Include="..\..\00_Shared\ProductionLine.ChatUI\GroupChatPanel.cs" Link="Chat\GroupChatPanel.cs" />
  </ItemGroup>

  <PropertyGroup>
    <AssemblyName>ProductionLine.UserApp.Moon</AssemblyName>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
  <!-- 화면 배율(예: 175%)에서 글자가 잘리지 않도록 100% 기준 화면을 윈도우가 키워서 보여 줌 (김하균) -->
    <ApplicationHighDpiMode>DpiUnawareGdiScaled</ApplicationHighDpiMode>
  </PropertyGroup>

</Project>
